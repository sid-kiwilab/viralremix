# Copy to `.env.local` (or `.env`) for local overrides. Never commit real keys.

# Optional: Python executable when not on PATH (Windows). Used only if CLOUD_RUN_URL is unset.
# PYTHON_PATH=C:\Python312\python.exe

# Cloud Run fetch worker (yt-dlp + curl_cffi). When CLOUD_RUN_URL is set (trimmed, non-empty),
# POST /api/ingest calls Cloud Run instead of local Python. FETCH_SERVICE_SECRET is required too.
# CLOUD_RUN_URL=https://viralremix-fetch-898633406084.australia-southeast1.run.app
# FETCH_SERVICE_SECRET=

# Neon: log failed Reel / TikTok downloads to ingest_errors (not user cancel / 499)
# NEON_CONNECTION_STRING=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Local fallback ingest (only when CLOUD_RUN_URL is unset):
#   pip install yt-dlp curl_cffi
