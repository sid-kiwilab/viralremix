# Copy to `.env.local` (or `.env`) for local overrides. Never commit real keys.

# Optional: Python executable when not on PATH (Windows). Used only if CLOUD_RUN_URL is unset.
# PYTHON_PATH=C:\Python312\python.exe

# Cloud Run fetch worker (yt-dlp + curl_cffi). When CLOUD_RUN_URL is set (trimmed, non-empty),
# POST /api/ingest calls Cloud Run instead of local Python. FETCH_SERVICE_SECRET is required too.
# CLOUD_RUN_URL=https://viralremix-fetch-898633406084.australia-southeast1.run.app
# FETCH_SERVICE_SECRET=

# Neon: ingest_errors (failed downloads) + analyze_runs (versioned recreatability logs; not 499 cancel)
# NEON_CONNECTION_STRING=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# OpenRouter: recreatability analysis after Fetch (POST /api/analyze). Server-side only.
# OPENROUTER_API_KEY=
# Optional override — default google/gemini-2.5-flash (stable). Preview IDs only when video handling is proven:
# OPENROUTER_VIDEO_MODEL=google/gemini-3-flash-preview

# EvoLink: Remix CLI (npm run remix) — Seedance 2.5 reference-to-video + Qwen TTS. Server-side only.
# EVOLINK_API_KEY=
# Cheap remix defaults (final MP4 is still 1080×1920 in Remotion; source clip may be 720p upscaled):
# EVOLINK_VIDEO_QUALITY=720p
# EVOLINK_VIDEO_MAX_SEC=5
# Lip-sync experiment only (npm run lipsync-lab): cheaper Seedance variant
# EVOLINK_LIPSYNC_MODEL=seedance-2.0-mini-reference-to-video
# One 8s 1080p ref-to-video clip can be ~400 credits; 5s 720p is much lower — see EvoLink dashboard.
# Optional: public base URL for Luca JPGs (no trailing slash). Default GitHub raw on main.
# REMIX_LUCA_REF_BASE=https://raw.githubusercontent.com/sid-kiwilab/viralremix/main/public/avatars/luca
# Optional Qwen voice id (see EvoLink qwen-audio-3.1-tts-flash voice list). Omit for default voice.
# EVOLINK_TTS_VOICE=Emily_v3.1

# recreate-segment: >8s default RECREATE_AUDIO=lipsync-segments (per-phrase EvoLink; Remotion composites lip-sync only).
# RECREATE_AUDIO=lipsync-segments|tts|evolink|source
# RECREATE_VISUAL_MODE=stable-loop|chain
# RECREATE_TRIM_TAIL_SEC=1
# RECREATE_MAX_SEC=20

# OpenRouter: also used by Remix CLI plan step (text JSON). Optional separate model:
# OPENROUTER_PLAN_MODEL=google/gemini-2.5-flash

# ASR for recreate-segment / evolink-from-reference (word timestamps):
# Default: Groq if GROQ_API_KEY set, else OpenAI if OPENAI_API_KEY, else OpenRouter Gemini.
# TRANSCRIBE_PROVIDER=groq|openai|openrouter
# TRANSCRIBE_GROQ_MODEL=whisper-large-v3-turbo
# TRANSCRIBE_OPENAI_MODEL=whisper-1
# OPENROUTER_TRANSCRIBE_MODEL=google/gemini-2.5-flash
# GROQ_API_KEY=
# OPENAI_API_KEY=

# Local fallback ingest (only when CLOUD_RUN_URL is unset):
#   pip install yt-dlp curl_cffi
