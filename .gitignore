# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/build

# All generated video output (recreate, remix, lipsync-lab, rosettastone tests)
/out/

# Per-video set plates copied here for EvoLink @image4 — regenerate from recreate scripts
/public/recreate-plates/

# production / misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local secrets: keep .env / .env.local on your machine; never commit them.
.env*
!.env.example

# Legacy ingest cache (no longer used)
/.data/

# vercel
.vercel

# typescript / remotion
*.tsbuildinfo
next-env.d.ts
.remotion/

# ASR / ffmpeg temp next to source videos (under out/ too, but safe if paths move)
.transcribe-*.mp3

# Stray media at repo root (never commit renders)
/*.mp4
/*.mov
/*.webm
/*.mp3
/*.aac
